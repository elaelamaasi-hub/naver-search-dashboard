# Streamlit Community Cloud의 "App settings > Secrets"에 등록할 키 예시입니다.
# 1. 네이버 클라우드 플랫폼 (NAVER Cloud API Hub) 사용 시 (권장)
NCLOUD_API_KEY_ID = "your_ncloud_api_key_id"
NCLOUD_API_KEY = "your_ncloud_api_key_secret"

# 2. 네이버 개발자 센터 레거시 오픈 API 사용 시
NAVER_CLIENT_ID = "your_naver_client_id"
NAVER_CLIENT_SECRET = "your_naver_client_secret"
